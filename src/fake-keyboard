#!/usr/bin/env bash
# Control the two FaKeyboard-emulated Corsair keyboards used for ckb-next daemon
# development (profile/mode handling). For setup, see doc/fake-keyboards-setup.md.
set -euo pipefail

# Defaults to the directory this script lives in (it's built alongside hid-keyboard*), so the
# repo works when cloned anywhere - override FAKEYBOARD_SRC to point elsewhere.
FAKEYBOARD_SRC="${FAKEYBOARD_SRC:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)}"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/fake-keyboard-$USER"
mkdir -p "$RUN_DIR"

declare -A DEV_BINARY=( [strafe]=hid-keyboard              [k68]=hid-keyboard-special )
declare -A DEV_PORT=(   [strafe]=3240                      [k68]=3241 )
declare -A DEV_PID=(    [strafe]="1b1c:1b15"                [k68]="1b1c:1b4f" )
declare -A DEV_LABEL=(  [strafe]="Corsair Strafe (non-RGB)" [k68]="Corsair K68" )
declare -A DEV_MATCH=(  [strafe]="Fake"                     [k68]="Snowflake" )
ALL_DEVICES=(strafe k68)

# Bit index (0-151) into the 19-byte Corsair software-mode keymap bitmap - i.e. the 0-based
# position of the entry in src/daemon/keymap.c's keymap[] array, NOT its "scan" hex field.
# Only wired up for k68 (see cmd_key) - regenerate/extend by re-deriving from that array if a
# key you need isn't listed here.
declare -A KEY_INDEX=(
    [esc]=0 [tab]=24 [q]=25 [w]=26 [e]=27 [r]=28 [t]=29 [y]=30 [u]=31 [i]=32 [o]=33 [p]=34
    [a]=37 [s]=38 [d]=39 [f]=40 [g]=41 [h]=42 [j]=43 [k]=44 [l]=45
    [lshift]=48 [z]=50 [x]=51 [c]=52 [v]=53 [b]=54 [n]=55 [m]=56
    [lctrl]=60 [lalt]=62 [space]=64 [enter]=82
    [up]=92 [left]=93 [down]=94 [right]=95
    [1]=13 [2]=14 [3]=15 [4]=16 [5]=17 [6]=18 [7]=19 [8]=20 [9]=21 [0]=22
)

usage() {
    cat <<'EOF'
fake-keyboard - control the emulated Corsair keyboards (FaKeyboard/USB-IP)

Usage:
  fake-keyboard start   [strafe|k68|all]   Launch server + attach via usbip (default: all)
  fake-keyboard stop    [strafe|k68|all]   Detach via usbip + kill server   (default: all)
  fake-keyboard restart [strafe|k68|all]
  fake-keyboard status  [strafe|k68|all]   Show server/attach/daemon-node state
  fake-keyboard cmd     <strafe|k68> <ckb-next command...>
                                           Write a command to the device's cmd FIFO
  fake-keyboard logs    <strafe|k68>       Tail the server's log (Ctrl-C to stop)
  fake-keyboard key     <strafe|k68> <key-name>
                                           Simulate a physical keypress+release (k68 only for now)

Devices:
  strafe   Corsair Strafe non-RGB (1b1c:1b15) - plain NXP profile path
  k68      Corsair K68 (1b1c:1b4f)            - V2/V3-override profile path

Example:
  fake-keyboard start
  fake-keyboard status
  fake-keyboard cmd strafe mode 2
  fake-keyboard stop all

See doc/fake-keyboards-setup.md for background and one-time host setup
(usbip package, vhci-hcd kernel module).
EOF
}

resolve_devices() {
    local arg=${1:-all}
    if [[ "$arg" == "all" ]]; then
        echo "${ALL_DEVICES[@]}"
    elif [[ -n "${DEV_BINARY[$arg]+x}" ]]; then
        echo "$arg"
    else
        echo "unknown device '$arg' (expected: ${ALL_DEVICES[*]} or all)" >&2
        exit 1
    fi
}

is_running() {
    local dev=$1 pidfile="$RUN_DIR/$dev.pid"
    [[ -f "$pidfile" ]] || return 1
    local pid
    pid=$(cat "$pidfile")
    if kill -0 "$pid" 2>/dev/null; then
        return 0
    fi
    rm -f "$pidfile"
    return 1
}

wait_listen() {
    local logfile=$1 waited=0
    while ! grep -q "Listening on TCP port" "$logfile" 2>/dev/null; do
        sleep 0.2
        waited=$((waited + 1))
        if (( waited > 25 )); then
            return 1
        fi
    done
}

server_start() {
    local dev=$1 binary=${DEV_BINARY[$1]} port=${DEV_PORT[$1]}
    local pidfile="$RUN_DIR/$dev.pid" logfile="$RUN_DIR/$dev.log"

    if is_running "$dev"; then
        echo "[$dev] server already running (pid $(cat "$pidfile"))"
        return 0
    fi

    local bin_path="$FAKEYBOARD_SRC/$binary"
    if [[ ! -d "$FAKEYBOARD_SRC" ]]; then
        echo "[$dev] $FAKEYBOARD_SRC not found - see doc/fake-keyboards-setup.md" >&2
        return 1
    fi
    if [[ ! -x "$bin_path" ]]; then
        echo "[$dev] $binary not built yet, building..."
        make -C "$FAKEYBOARD_SRC" "$binary"
    fi

    : > "$logfile"
    # stdbuf: the emulator fully-buffers stdio when not attached to a TTY, so the
    # "Listening on TCP port" line otherwise never reaches the log until exit.
    # FAKEYBOARD_CTRL_FIFO: only acted on by binaries that register a ctrl_line_handler
    # (currently just k68) - harmless to set for every device.
    FAKEYBOARD_PORT="$port" FAKEYBOARD_CTRL_FIFO="$RUN_DIR/$dev.ctrl" \
        stdbuf -oL -eL "$bin_path" >>"$logfile" 2>&1 &
    local pid=$!
    disown
    echo "$pid" > "$pidfile"

    if wait_listen "$logfile"; then
        echo "[$dev] server started (pid $pid, port $port)"
    else
        echo "[$dev] server failed to start, see $logfile" >&2
        return 1
    fi
}

server_stop() {
    local dev=$1 pidfile="$RUN_DIR/$dev.pid"
    if ! is_running "$dev"; then
        echo "[$dev] server not running"
        return 0
    fi
    local pid
    pid=$(cat "$pidfile")
    kill "$pid" 2>/dev/null || true
    rm -f "$pidfile"
    echo "[$dev] server stopped (pid $pid)"
}

find_attached_port() {
    local dev=$1 port=${DEV_PORT[$1]}
    sudo usbip port 2>/dev/null | awk -v tcp="127.0.0.1:${port}/" '
        /^Port [0-9]+:/ { p = $2; sub(":", "", p) }
        $0 ~ tcp { print p; exit }
    ' || true
}

attach_dev() {
    local dev=$1 port=${DEV_PORT[$1]}
    local existing
    existing=$(find_attached_port "$dev")
    if [[ -n "$existing" ]]; then
        echo "[$dev] already attached (vhci port $existing)"
        return 0
    fi
    local busid
    busid=$(sudo usbip --tcp-port "$port" list -r 127.0.0.1 2>/dev/null \
        | grep -oP '^\s+\K[0-9]+-[0-9]+(?=:)' | head -1) || true
    if [[ -z "$busid" ]]; then
        echo "[$dev] could not list exportable device on port $port (server not listening?)" >&2
        return 1
    fi
    # vhci_hcd's "open vhci_driver" occasionally fails while the daemon is busy
    # retrying its ~10s connection handshake with another just-attached device
    # (see doc/fake-keyboards-setup.md); retry generously rather than race it.
    local attempt
    for attempt in $(seq 1 10); do
        if sudo usbip --tcp-port "$port" attach -r 127.0.0.1 -b "$busid"; then
            echo "[$dev] attached (busid $busid, port $port)"
            return 0
        fi
        sleep 2
    done
    echo "[$dev] attach failed after $attempt attempts" >&2
    return 1
}

detach_dev() {
    local dev=$1
    local vport
    vport=$(find_attached_port "$dev")
    if [[ -z "$vport" ]]; then
        echo "[$dev] not attached"
        return 0
    fi
    sudo usbip detach -p "$vport"
    echo "[$dev] detached (was vhci port $vport)"
}

find_ckb_path() {
    local dev=$1 match=${DEV_MATCH[$1]}
    grep -F "$match" /dev/input/ckb0/connected 2>/dev/null | awk '{print $1}' | head -1 || true
}

cmd_status() {
    if ! command -v usbip >/dev/null; then
        echo "warning: usbip client not installed (sudo pacman -S usbip)" >&2
    fi
    if ! lsmod | grep -q '^vhci_hcd'; then
        echo "warning: vhci_hcd kernel module not loaded (sudo modprobe vhci-hcd)" >&2
    fi
    for dev in "$@"; do
        echo "== $dev (${DEV_LABEL[$dev]}, ${DEV_PID[$dev]}) =="
        if is_running "$dev"; then
            echo "  server:  running (pid $(cat "$RUN_DIR/$dev.pid"), port ${DEV_PORT[$dev]})"
        else
            echo "  server:  stopped"
        fi
        local vport
        vport=$(find_attached_port "$dev")
        if [[ -n "$vport" ]]; then
            echo "  usbip:   attached (vhci port $vport)"
        else
            echo "  usbip:   not attached"
        fi
        local ckb
        ckb=$(find_ckb_path "$dev")
        if [[ -n "$ckb" ]]; then
            echo "  daemon:  $ckb"
        else
            echo "  daemon:  not visible in /dev/input/ckb0/connected"
        fi
    done
}

cmd_send() {
    local dev=$1
    shift
    local ckb
    ckb=$(find_ckb_path "$dev")
    if [[ -z "$ckb" ]]; then
        echo "[$dev] not connected to the daemon (start it first)" >&2
        return 1
    fi
    echo "$*" > "$ckb/cmd"
    echo "[$dev] -> $ckb/cmd: $*"
}

cmd_key() {
    local dev=$1 name=$2
    local idx=${KEY_INDEX[$name]:-}
    if [[ -z "$idx" ]]; then
        echo "unknown key name '$name' (known: ${!KEY_INDEX[*]})" >&2
        return 1
    fi
    local fifo="$RUN_DIR/$dev.ctrl"
    if ! is_running "$dev"; then
        echo "[$dev] server not running" >&2
        return 1
    fi
    if [[ ! -p "$fifo" ]]; then
        echo "[$dev] control fifo not found at $fifo (device may not support key injection yet)" >&2
        return 1
    fi
    # Open read-write (not write-only) so this doesn't block waiting for a reader even if the
    # timing is unlucky - the server itself holds the fifo open O_RDWR for its whole lifetime.
    local fd
    exec {fd}<>"$fifo"
    printf 'key %s\n' "$idx" >&"$fd"
    exec {fd}>&-
    echo "[$dev] -> $fifo: key $name (index $idx)"
}

cmd_logs() {
    local dev=$1 logfile="$RUN_DIR/$dev.log"
    if [[ ! -f "$logfile" ]]; then
        echo "[$dev] no log yet (server not started)" >&2
        return 1
    fi
    tail -f "$logfile"
}

main() {
    local action=${1:-}
    case "$action" in
        start)
            for dev in $(resolve_devices "${2:-all}"); do
                server_start "$dev"
                attach_dev "$dev"
            done
            ;;
        stop)
            for dev in $(resolve_devices "${2:-all}"); do
                detach_dev "$dev"
                server_stop "$dev"
            done
            ;;
        restart)
            for dev in $(resolve_devices "${2:-all}"); do
                detach_dev "$dev"
                server_stop "$dev"
                server_start "$dev"
                attach_dev "$dev"
            done
            ;;
        status)
            cmd_status $(resolve_devices "${2:-all}")
            ;;
        cmd)
            local dev=${2:?usage: fake-keyboard cmd <strafe|k68> <command...>}
            shift 2
            cmd_send "$dev" "$@"
            ;;
        logs)
            local dev=${2:?usage: fake-keyboard logs <strafe|k68>}
            cmd_logs "$dev"
            ;;
        key)
            local dev=${2:?usage: fake-keyboard key <strafe|k68> <key-name>}
            local name=${3:?usage: fake-keyboard key <strafe|k68> <key-name>}
            cmd_key "$dev" "$name"
            ;;
        -h|--help|help|"")
            usage
            ;;
        *)
            echo "unknown command: $action" >&2
            usage
            exit 1
            ;;
    esac
}

main "$@"
